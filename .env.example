# ────── Telegram ──────────────────────────────
# Токен від @BotFather
BOT_TOKEN=your_bot_token_here

# ID закритої супергрупи (з мінусом, наприклад -1001234567890)
# Дізнатись: перешли будь-яке повідомлення з групи боту @userinfobot
GROUP_ID=-100xxxxxxxxx

# Твій Telegram ID (дізнатись у @userinfobot)
# Кілька адмінів через кому: 123456,789012
ADMIN_IDS=your_telegram_id

# ────── LiqPay (залишити порожнім поки безкоштовно) ──────────
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# ────── Сервер ────────────────────────────────
# URL твого додатку на Railway
SERVER_URL=https://your-app.railway.app
